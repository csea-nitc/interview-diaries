{
  "kind": "collectionType",
  "collectionName": "interview_diaries",
  "info": {
    "singularName": "interview-diary",
    "pluralName": "interview-diaries",
    "displayName": "Interview Diary",
    "description": "Approved, published interview experiences"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "candidateName": {
      "type": "string",
      "required": true
    },
    "roleType": {
      "type": "enumeration",
      "enum": ["Full Time", "Internship"],
      "required": true
    },
    "jobTitle": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "stipend": {
      "type": "string"
    },
    "totalRounds": {
      "type": "integer"
    },
    "writtenTests": {
      "type": "integer"
    },
    "interviews": {
      "type": "integer"
    },
    "tips": {
      "type": "text"
    },
    "company": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::company.company",
      "inversedBy": "diaries"
    },
    "ctc": {
      "type": "integer"
    },
    "isPPO": {
      "type": "boolean",
      "default": false
    },
    "rounds": {
      "type": "component",
      "repeatable": true,
      "component": "interview.round"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
